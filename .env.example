# Copy to .env (gitignored) or set these in Settings. Never commit real keys.
# Environment variables override values in this file.

# The Odds API (https://the-odds-api.com) for live moneylines; ESPN odds are used without it.
ODDS_API_KEY=

# Telegram bot for sending VIP picks.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Where `python -m server` listens. Keep the loopback address unless you know you need otherwise.
NBA_HOST=127.0.0.1
NBA_PORT=8000

# Demo mode: replay a past date from the 2010-24 history files (no network). Leave empty for live.
# NBA_QUANT_DEMO_DATE=2024-03-15
